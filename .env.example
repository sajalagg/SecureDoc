# Generate a 32-byte Base64 master key with:
# PYTHONPATH=backend python -c "from app.encryption.crypto import generate_key, encode_key; print(encode_key(generate_key()))"
# Never commit the real value to Git.
SECUREDOC_MASTER_KEY_BASE64=replace-with-a-generated-32-byte-base64-key

# Generate separately with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Used only to sign short-lived API access tokens; never commit the real value.
SECUREDOC_AUTH_SECRET=replace-with-a-random-token-signing-secret

# Optional local SQLite path. The default is securedoc.db in the current directory.
SECUREDOC_DATABASE_PATH=securedoc.db
